# Copy to .env and fill in. docker-compose.yml supplies its own development
# values, so this file is only needed to run outside Docker or for production.

# ── Required everywhere ──
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DATABASE_URL=postgres://aviro:aviro@localhost:5432/aviro

# ── Production only ──
DJANGO_ALLOWED_HOSTS=api.aviro.ng
CORS_ALLOWED_ORIGINS=https://aviro.ng,https://www.aviro.ng
DJANGO_LOG_LEVEL=INFO
WEB_CONCURRENCY=3

# ── Postgres, for docker-compose.prod.yml ──
POSTGRES_DB=aviro
POSTGRES_USER=aviro
POSTGRES_PASSWORD=change-me

# How verification codes are delivered: console | sms | whatsapp
OTP_DELIVERY=console
